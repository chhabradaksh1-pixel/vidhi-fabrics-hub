{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "^http$"
        },
        {
          "type": "host",
          "value": "^(?:www\\.)?vidhifabrics\\.com$"
        }
      ],
      "destination": "https://www.vidhifabrics.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^vidhifabrics\\.com$"
        }
      ],
      "destination": "https://www.vidhifabrics.com/:path*",
      "statusCode": 301
    }
  ]
}
